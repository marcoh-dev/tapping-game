{
	"name": "tapping-game",
	"version": "0.0.0-unreleased",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "next typegen && tsc --noEmit",
		"check": "npm run lint && npm run format:check && npm run typecheck",
		"test": "vitest run",
		"test:watch": "vitest",
		"sync": "git switch main && git pull && node scripts/install-if-changed.mjs && docker compose up -d --wait",
		"sync:branch": "git fetch origin && git merge --no-commit origin/main && node scripts/install-if-changed.mjs && docker compose up -d --wait"
	},
	"engines": {
		"node": "24.x"
	},
	"dependencies": {
		"@next-auth/mongodb-adapter": "^1.1.3",
		"mongodb": "^5.9.2",
		"mongoose": "^9.7.2",
		"next": "16.4.5",
		"next-auth": "^4.24.14",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"styled-components": "^6.0.2",
		"use-local-storage-state": "^19.5.0"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.4.3",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "9.39.5",
		"eslint-config-next": "16.4.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"jsdom": "^31.0.0",
		"prettier": "^3.9.10",
		"typescript": "~6.0",
		"vitest": "^5.1.0"
	},
	"description": "Next.js (incl. Styled Components and Vitest)",
	"nf": {
		"template": "next"
	}
}
